              "secondaryKey": "WeaponSet_SMG_A_name"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Diagnostic 1 of 4: our appearance resource, every slot left stock. Equip it. If this freezes, the fault is in our .app or a mesh in it.",
